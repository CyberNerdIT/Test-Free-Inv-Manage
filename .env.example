# Copy this file to ".env" and fill in what you need. Everything here is
# optional: the app runs fine with none of it.
#
# Note on the marketplace credentials below: live eBay and Amazon lookups are
# part of the Pro upgrade and this build contains no code that can call either
# API, so keys entered here are stored and nothing more. They are kept (rather
# than removed) so an install that upgrades later has nothing to re-enter, and
# the admin page says so plainly instead of leaving you to wonder. Pricing falls
# back to the built-in demo provider, clearly labelled as simulated.

# Server
PORT=3000

# ---------------------------------------------------------------------------
# Edition / support (optional)
# ---------------------------------------------------------------------------
# Set INV_HOSTED=1 on instances YOU operate. It grants nothing — it only swaps
# "run this command" for "contact support", which is the only honest advice for
# someone with no shell.
# INV_HOSTED=1
# Where a hosted customer should be sent for help.
# INV_SUPPORT_URL=
# Where the admin page points for the Pro upgrade. Upgrading is not automatic
# yet, so leave this empty and the page simply says to get in touch.
# INV_UPGRADE_URL=

# ---------------------------------------------------------------------------
# eBay Browse API (active listings) + Marketplace Insights (recently sold)
# ---------------------------------------------------------------------------
# Create an app at https://developer.ebay.com/ -> get a Client ID / Client Secret.
# The Browse API (active listings) works with just these two values.
# "Recently sold" data comes from the Marketplace Insights API, which requires
# separate access approval from eBay. Until granted, sold comps fall back to demo.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Use "PRODUCTION" or "SANDBOX"
EBAY_ENV=PRODUCTION
# eBay marketplace, e.g. EBAY_US, EBAY_GB, EBAY_DE
EBAY_MARKETPLACE=EBAY_US

# ---------------------------------------------------------------------------
# Amazon Product Advertising API v5 (optional)
# ---------------------------------------------------------------------------
# Requires an approved Amazon Associates account + PA-API keys.
# See README for why Amazon "sold" data is not available.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_REGION=us-east-1
AMAZON_HOST=webservices.amazon.com

# ---------------------------------------------------------------------------
# Default marketplace assumptions used for break-even / profit suggestions
# ---------------------------------------------------------------------------
# Selling fee as a fraction (eBay final value fee is ~0.132 for most categories)
DEFAULT_FEE_RATE=0.132
# Flat payment/transaction fee added per sale (e.g. $0.30)
DEFAULT_FLAT_FEE=0.30
# Default target profit margin (fraction of total cost) for price suggestions
DEFAULT_TARGET_MARGIN=0.25
