{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tech Garage community registry",
  "type": "object",
  "required": ["version", "nodes"],
  "properties": {
    "version": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "name", "url", "region"],
        "additionalProperties": false,
        "properties": {
          "node": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{40,120}={0,2}$",
            "description": "The shop's Ed25519 public key — its identity. From Admin → Community directory."
          },
          "name": { "type": "string", "maxLength": 80 },
          "tagline": { "type": "string", "maxLength": 160 },
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\s?#]+$",
            "description": "Public base URL. Must serve /api/directory/verify returning this node id."
          },
          "region": {
            "type": "object",
            "required": ["country"],
            "additionalProperties": false,
            "description": "Coarse location only. No street, no coordinates.",
            "properties": {
              "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
              "state": { "type": "string", "maxLength": 40 },
              "area": { "type": "string", "maxLength": 60 },
              "postalPrefix": { "type": "string", "maxLength": 4 }
            }
          },
          "categories": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "maxLength": 30 }
          },
          "contact": { "type": "string", "maxLength": 200 },
          "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
